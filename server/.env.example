PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed to submit forms to this API.
# The production GitHub Pages origin and common local Vite ports are allowed by default.
ALLOWED_ORIGINS=https://diamondbzresources.github.io

# Enforced automatically when NODE_ENV=production. Set false only behind a trusted setup
# that terminates TLS before requests reach this process and correctly sets X-Forwarded-Proto.
ENFORCE_HTTPS=false

# Submission abuse controls. Defaults: 30 requests per 15 minutes per IP and route.
FORM_RATE_LIMIT_MAX=30
FORM_RATE_LIMIT_WINDOW_MINUTES=15

# Secure delivery endpoint for applicant and new-hire forms.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_BEARER_TOKEN=

# Recommended. The server signs `${timestamp}.${rawJsonBody}` with HMAC-SHA256 and sends
# X-BZ-Timestamp plus X-BZ-Signature: sha256=<digest> to the webhook receiver.
FORM_WEBHOOK_SIGNING_SECRET=

# Development only. Production webhooks should always use HTTPS.
ALLOW_INSECURE_WEBHOOK=false
