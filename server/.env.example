NODE_ENV=development
PORT=4000

# Comma-separated origins. GitHub Pages uses the site ORIGIN, not the repo path.
ALLOWED_ORIGIN=https://diamondbzresources.github.io,http://localhost:5173,http://localhost:5174

# Microsoft Entra app registration with Microsoft Graph APPLICATION permission: Mail.Send
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=noreply@yourdomain.com
FORM_RECIPIENT_EMAIL=vlake@bz-resources.com

# Google reCAPTCHA v2 Checkbox
RECAPTCHA_SECRET_KEY=
# Comma separated, hostname only. Example: diamondbzresources.github.io,bz-resources.com
RECAPTCHA_ALLOWED_HOSTNAMES=diamondbzresources.github.io

FORM_RATE_LIMIT_MAX=8
FORM_RATE_LIMIT_WINDOW_MINUTES=15
FORM_DUPLICATE_WINDOW_MINUTES=5
FORM_BODY_LIMIT=100kb

# Keep enabled behind an HTTPS reverse proxy in production.
ENFORCE_HTTPS=true
