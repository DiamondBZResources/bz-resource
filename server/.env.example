PORT=4000
NODE_ENV=development

# Exact comma-separated browser origins permitted to call the API. Never use *
# in production. Include the GitHub Pages origin and approved local origins.
ALLOWED_ORIGIN=https://diamondbzresources.github.io

# Enforced automatically in production unless explicitly disabled behind a
# trusted HTTPS-terminating proxy that supplies X-Forwarded-Proto.
ENFORCE_HTTPS=false

# Microsoft Entra application-only credentials. Store real values only in the
# backend host's secret manager or server environment.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-server-side-secret
GRAPH_SENDER_EMAIL=website-forms@example.com
FORM_RECIPIENT_EMAIL=staffing-inquiries@example.com

# Cloudflare Turnstile secret and optional hostname allowlist. The secret must
# never be placed in the client environment or frontend bundle.
TURNSTILE_SECRET_KEY=replace-with-server-side-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=diamondbzresources.github.io,localhost

# Abuse and request-size controls.
FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MINUTES=15
FORM_DUPLICATE_WINDOW_MINUTES=5
FORM_BODY_LIMIT=100kb
